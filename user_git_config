# This is Git's per-user configuration file.
[core] 
	editor = positron --wait
[user]
# Please adapt and uncomment the following lines:
	name = cnsodano
	email = cnsodano@gmail.com
[color]
    ui = auto
    diff = always
[init]
    defaultbranch = main
[alias]
    st = status
    ci = commit
    co = checkout
    restore-file = restore --worktree --stage
    stgd = diff --name-only --cached
    graph = log --branches --remotes --tags --graph --oneline --decorate --exclude=refs/stash
    graph-a = log --all --graph --decorate --oneline
    gr-a = log --all --graph --decorate --oneline
    gr = log --branches --remotes --tags --graph --oneline --decorate --exclude=refs/stash
    stash-keep = !git stash store $(git stash create)
    notest = !git add -- . ':!report_output'
    diff-last = diff HEAD~1 
