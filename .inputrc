$if mode=vi
    set keymap vi-insert
    "jk": vi-movement-mode
$endif

# Enable the mode indicator in the prompt
set show-mode-in-prompt on

# (Optional) Customize the text indicator style
set vi-ins-mode-string "(ins)"
set vi-cmd-mode-string "(cmd)"

# (Optional) Change cursor shape: Vertical bar for insert, Block for command
set vi-ins-mode-string \1\e[6 q\2
set vi-cmd-mode-string \1\e[2 q\2