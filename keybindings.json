                                     "when": "codeActionMenuVisible" },
{ "key": "ctrl+enter",            "command": "previewSelectedCodeAction",
                                     "when": "codeActionMenuVisible" },
{ "key": "ctrl+down",             "command": "selectNextCodeAction",
