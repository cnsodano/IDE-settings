{
    //*****SPEED ENHANCEMENTS*******
    //"workspace.searchEnabled": true,
    "editor.maxTokenizationLineLength": 2000,
    "workbench.editor.limit.enabled": true,
    "workbench.editor.limit.perEditorGroup": true,
    "workbench.editor.limit.value": 9,
    "search.exclude": {
        "**/.git": true,
        "**/.pytest_cache": true,
        "**/.venv": true,
        "**/cache": true,
        "**/renv": true,
        "**/.quarto/**": true,
    },
    "files.exclude": {
        "": true,
        "**/__pycache__": true,
        "**/.git": false,
        "**/.Rhistory": true,
        "**/.Rproj": true,
        "**/.Rproj.user": true,
        "**/renv/library": true,
        "**/renv/local": true,
        "**/renv/staging": true
    },
    "files.watcherExclude": {
        "**/.venv/**": true,
        "**/cache/**": true,
        "**/renv/**": true,
        "**/.quarto/**": true,
    },
    //************** TESTING *************************//
    "testing.alwaysRevealTestOnStateChange": true,
    "python.testing.pytestArgs": [
        "-s"
    ],
    //Window
    "editor.cursorSurroundingLines": 100,
    //************** R MAYBE NEED??? *****************//
    //"r.useRenvLibPath": true,
    //************** WEB DEV ************************//
    "[html]": {
        "editor.defaultFormatter": "vscode.html-language-features"
    },
    "livePreview.customExternalBrowser": "Firefox",
    "livePreview.debugOnExternalPreview": true,
    "livePreview.httpHeaders": {
        "Accept-Ranges": "bytes"
    },
    "livePreview.useIntegratedBrowser": true,
    "workbench.externalBrowser": "firefox",
    "liveServer.settings.CustomBrowser": "chrome:PrivateMode",
    "liveServer.settings.AdvanceCustomBrowserCmdLine": "chrome.exe",
    "workbench.browser.openLocalhostLinks": true,
    //************** ADMIN **************************//
    "terminal.integrated.defaultProfile.windows": "Git Bash",
    "workbench.startupEditor": "none",
    "terminal.integrated.shellIntegration.environmentReporting": true,
    "search.mode": "reuseEditor",
    "security.promptForLocalFileProtocolHandling": true,
    "terminal.integrated.initialHint": false,
    "terminal.integrated.allowedLinkSchemes": [
        "file",
        "http",
        "https",
        "mailto",
        "vscode",
        "vscode-insiders",
        "ms-settings"
    ],
    "terminal.integrated.gpuAcceleration": "off",
    //***************PROJECT MANAGEMENT*************//
    "terminal.integrated.inheritEnv": false,
    //************** PYTHON *************************//
    "[python]": {
        //"editor.defaultFormatter": "ms-python.black-formatter",
        "editor.formatOnSave": true,
        "diffEditor.ignoreTrimWhitespace": true,
        "editor.codeActionsOnSave": {
            "source.organizeImports": "explicit"
        }
    },
    "python.analysis.inlayHints.callArgumentNames": "all",
    "python.analysis.inlayHints.functionReturnTypes": true,
    "python.analysis.inlayHints.variableTypes": true,
    "python.analysis.supportDocstringTemplate": true,
    "python.analysis.typeEvaluation.strictDictionaryInference": true,
    //"python.analysis.inlayHints.pytestParameters": true,
    "python.languageServer": "Pylance",
    "jupyter.inspectKernelMessages.enabled": true,
    //"jupyter.notebookFileRoot": "${workspaceFolder}",
    "ipynb.experimental.serialization": false,
    "jupyter.debugJustMyCode": false,
    "jupyter.experimental.debugging": true,
    "jupyter.showVariableViewWhenDebugging": true,
    "jupyter.logging.level": "trace",
    "jupyter.askForKernelRestart": false,
    "jupyter.widgetScriptSources": [
        "jsdelivr.com",
        "unpkg.com"
    ],
    "jupyter.contextualHelp.detailLevel": "verbose",
    "jupyter.notebookRunGroups.runIconsOnCell": true,
    //*************** DEBUGGING **********************//
    "debug.inlineValues": "off",
    "debug.breakpointsView.presentation": "tree",
    "accessibility.debugWatchVariableAnnouncements": false,
    "accessibility.verbosity.debug": false,
    "debug.autoExpandLazyVariables": "off",
    "debug.closeReadonlyTabsOnEnd": true,
    "debug.showBreakpointsInOverviewRuler": true,
    "debug.console.fontSize": 18,
    "debug.internalConsoleOptions": "neverOpen",
    "debug.openDebug": "neverOpen",
    //***************APPEARANCE***********************//
    "peacock.affectWindowBorder": true,
    "peacock.affectStatusBar": false,
    "peacock.affectActivityBar": false,
    "peacock.affectDebuggingStatusBar": false,
    "peacock.affectTitleBar": true,
    "peacock.affectEditorGroupBorder": false,
    "peacock.affectPanelBorder": true,
    "peacock.affectSideBarBorder": false,
    "peacock.affectSashHover": true,
    "peacock.affectStatusAndTitleBorders": false,
    "peacock.affectTabActiveBorder": false,
    "peacock.affectTabActiveBackground": false,
    "editor.lineNumbers": "relative", // FOr Vim
    // Indent with two spaces, but only for R
    "editor.comments.ignoreemptylines": false,
    "editor.lineheight": 2,
    "zenMode.showTabs": "single",
    "explorer.compactFolders": false,
    "editor.fontFamily": "Consolas,  \"Courier New\", monospace",
    "editor.fontLigatures": "'calt', 'ss01', 'ss02', 'ss03', 'ss04', 'ss05', 'ss06', 'ss07', 'ss08', 'liga'",
    "workbench.tree.indent": 24,
    "workbench.editor.pinnedTabsOnSeparateRow": true,
    "workbench.editor.pinnedTabSizing": "shrink",
    "workbench.preferredDarkColorTheme": "Two Monokai",
    //"editor.codeLens": false,
    "editor.cursorBlinking": "solid",
    "editor.bracketPairColorization.independentColorPoolPerBracketType": true,
    "editor.guides.bracketPairs": "active",
    "chat.viewSessions.orientation": "stacked",
    "workbench.list.horizontalScrolling": true,
    "zenMode.hideStatusBar": false,
    "diffEditor.renderSideBySide": true,
    "zenMode.fullScreen": false,
    "zenMode.hideLineNumbers": false,
    "vim.cursorStylePerMode.visual": "block-outline",
    "better-comments.tags": [
        {
            "tag": "!",
            "color": "#ff8080",
            "strikethrough": false,
            "underline": false,
            "backgroundColor": "transparent",
            "bold": false,
            "italic": false
        },
        {
            "tag": "?",
            "color": "#3498DB",
            "strikethrough": false,
            "underline": false,
            "backgroundColor": "transparent",
            "bold": false,
            "italic": false
        }
    ],
    "editor.wordWrap": "bounded",
    "window.titleBarStyle": "custom", // For themes? 
    "editor.renderLineHighlightOnlyWhenFocus": true,
    //** FORMATTERS ***//
    "javascript.format.insertSpaceAfterOpeningAndBeforeClosingNonemptyBrackets": true,
    //** R **//
    "[r]": {
        "editor.formatOnSave": true,
        // Indent with two spaces, but only for R
        "editor.tabSize": 2
        //"editor.defaultFormatter": "REditorSupport.r"
    },
    "[quarto]": {
        //"editor.formatOnSave": false,
        "editor.defaultFormatter": "quarto.quarto"
    },
    //****************** EDITING QOL ************//
    "editor.detectIndentation": false,
    "editor.showFoldingControls": "always",
    "window.title": "${dirty}${activeEditorShort}${separator}${rootName}${separator}${profileName}${separator}${appName}",
    "editor.inlineSuggest.edits.showCollapsed": true,
    //"editor.inlayHints.enabled": "offUnlessPressed",
    "editor.acceptSuggestionOnEnter": "off",
    "editor.snippetSuggestions": "top",
    "editor.formatOnPaste": true,
    "[json]": {
        "editor.defaultFormatter": "vscode.json-language-features"
    },
    "editor.semanticHighlighting.enabled": true,
    "editor.suggest.preview": true,
    "editor.suggest.localityBonus": true,
    "editor.suggestSelection": "recentlyUsed",
    "workbench.editor.doubleClickTabToToggleEditorGroupSizes": "maximize",
    "editor.inlineSuggest.syntaxHighlightingEnabled": true,
    "editor.fontSize": 16,
    //****************** VIM *********************//
    "vim.easymotion": true,
    "vim.incsearch": true,
    "vim.useSystemClipboard": false,
    "vim.useCtrlKeys": true,
    "vim.highlightedyank.enable": true,
    "vim.highlightedyank.color": "#a9dc7660",
    "vim.highlightedyank.duration": 250,
    "vim.hlsearch": true,
    "vim.mouseSelectionGoesIntoVisualMode": false,
    "vim.foldfix": true,
    // To improve performance
    "extensions.experimental.affinity": {
        "vscodevim.vim": 1
    },
    // "editor.cursorSurroundingLines": 8, 
    "vim.smartRelativeLine": true,
    "window.customMenuBarAltFocus": false, // For Vim navigation?
    "window.enableMenuBarMnemonics": false, // For Vim navigation?
    "editor.peekWidgetDefaultFocus": "editor", // to make focus peek editor when peeking for scrolling 
    "vim.easymotionDimBackground": false,
    //** VIM KEYBINDINGS
    "vim.leader": "<space>",
    "vim.handleKeys": {
        "<C-a>": false,
        "<C-f>": false,
        "<C-x>": false,
        "<C-z>": false,
        "<C-y>": false,
        "<C-o": true,
        "<C-p>": false,
        "<C-c>": false,
        "<C-v>": false,
    },
    "vim.insertModeKeyBindings": [
        {
            "before": [
                "j",
                "k"
            ],
            "after": [
                "<Esc>"
            ]
        },
        {
            "before": [
                "<C-w>",
                "L"
            ],
            "commands": [
                "workbench.action.moveEditorToRightGroup"
            ]
        },
        {
            "before": [
                "<C-w>",
                "H"
            ],
            "commands": [
                "workbench.action.moveEditorToLeftGroup"
            ]
        },
        {
            "before": [
                "<C-w>",
                "J"
            ],
            "commands": [
                "workbench.action.moveEditorToNextGroup"
            ]
        },
        {
            "before": [
                "<C-w>",
                "K"
            ],
            "commands": [
                "workbench.action.moveEditorToPreviousGroup"
            ]
        },
    ],
    "vim.insertModeKeyBindingsNonRecursive": [
        {
            "before": [
                "Insert"
            ],
            "after": [
                "Escape"
            ]
        },
    ],
    "vim.normalModeKeyBindings": [
        {
            "before": [
                "<leader>",
                "b"
            ],
            "commands": [
                "editor.debug.action.toggleInlineBreakpoint"
            ]
        },
        {
            "before": [
                "<C-w>",
                "L"
            ],
            "commands": [
                "workbench.action.moveEditorToRightGroup"
            ]
        },
        {
            "before": [
                "<C-w>",
                "H"
            ],
            "commands": [
                "workbench.action.moveEditorToLeftGroup"
            ]
        },
        {
            "before": [
                "<C-w>",
                "J"
            ],
            "commands": [
                "workbench.action.moveEditorToNextGroup"
            ]
        },
        {
            "before": [
                "<C-w>",
                "K"
            ],
            "commands": [
                "workbench.action.moveEditorToPreviousGroup"
            ]
        },
        {
            "before": [
                "H"
            ],
            "commands": [
                "editor.action.outdentLines"
            ]
        },
        {
            "before": [
                "L"
            ],
            "commands": [
                "editor.action.indentLines"
            ]
        },
        {
            "before": [
                "<Delete>"
            ],
            "commands": [
                "deleteRight",
            ]
        },
        {
            "before": [
                "<Backspace>"
            ],
            "commands": [
                "deleteLeft"
            ]
        },
        {
            "before": [
                "<leader>",
                "g",
                "r"
            ], // Revert hunk
            "commands": [
                "git.revertSelectedRanges"
            ]
        },
        {
            "before": [
                "<leader>",
                "<Enter>",
            ],
            "commands": [
                "editor.action.showContextMenu"
            ]
        },
        // git peek
        {
            "before": [
                "<leader>",
                "g",
                "p"
            ], // Peek Git diff for the changed line
            "commands": [
                "editor.action.dirtydiff.next"
            ]
        },
        // LSP settings
        {
            "before": [
                "<C-w>",
                "q",
            ],
            "commands": [
                ":q"
            ]
        },
        {
            "before": [
                "<leader>",
                "g",
                "t",
                "p",
                "d"
            ],
            "commands": [
                "editor.action.peekDefinition"
            ]
        },
        {
            "before": [
                "g",
                "t",
                "i"
            ],
            "commands": [
                "editor.action.goToImplementation"
            ]
        },
        {
            "before": [
                "g",
                "t",
                "p",
                "i"
            ],
            "commands": [
                "editor.action.peekImplementation"
            ]
        },
        {
            "before": [
                "g",
                "t",
                "q"
            ],
            "commands": [
                "editor.action.quickFix"
            ]
        },
        {
            "before": [
                "g",
                "t",
                "r"
            ],
            "commands": [
                "editor.action.referenceSearch.trigger"
            ]
        },
        {
            "before": [
                "g",
                "t",
                "t"
            ],
            "commands": [
                "editor.action.goToTypeDefinition"
            ]
        },
        {
            "before": [
                "g",
                "t",
                "p",
                "t"
            ],
            "commands": [
                "editor.action.peekTypeDefinition"
            ]
        },
        {
            "before": [
                "g",
                "t",
                "h"
            ],
            "commands": [
                "editor.action.showDefinitionPreviewHover"
            ]
        },
        {
            "before": [
                "<leader>",
                "e"
            ],
            "commands": [
                "workbench.view.explorer"
            ]
        }
    ],
    "vim.normalModeKeyBindingsNonRecursive": [
        {
            "before": [
                "<leader>",
                "d"
            ],
            "after": [
                "d",
                "d"
            ]
        },
        {
            "before": [
                "<C-n>"
            ],
            "commands": [
                ":nohl"
            ]
        },
        {
            "before": [
                "K"
            ],
            "commands": [
                "lineBreakInsert"
            ],
            "silent": true
        }
    ],
    "vim.visualModeKeyBindingsNonRecursive": [
        //Git
        {
            "before": [
                "<leader>",
                "g",
                "r"
            ], // Revert hunk
            "commands": [
                "git.revertSelectedRanges"
            ]
        },
        {
            "before": [
                "<leader>",
                "d"
            ],
            "after": [
                "d",
                "d"
            ]
        },
        {
            "before": [
                "<C-n>"
            ],
            "commands": [
                ":nohl"
            ]
        },
        {
            "before": [
                "K"
            ],
            "commands": [
                "lineBreakInsert"
            ],
            "silent": true
        },
    ],
    "vim.visualModeKeyBindings": [
        {
            "before": [
                "o"
            ],
            "after": [
                "v",
                "o"
            ]
        },
        {
            "before": [
                "O"
            ],
            "after": [
                "v",
                "O"
            ]
        },
        {
            "before": [
                "<Delete>"
            ],
            "after": [
                "x",
            ]
        },
        {
            "before": [
                "j",
                "k"
            ],
            "after": [
                "v"
            ]
        },
        {
            "before": [
                "<C-x>",
            ],
            "after": [
                "d",
                "d"
            ]
        },
    ],
